<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KickHub.Desktop.Views.ManageMatchesWindow"
        Width="800"
        Height="650"
        Title="KickHub - Manage Matches">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="MANAGE MATCHES"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock Text="Schedule New Match"
                   FontSize="22"
                   FontWeight="Bold"/>

        <TextBlock Text="Home Team"/>
        <ComboBox x:Name="HomeTeamBox"/>

        <TextBlock Text="Away Team"/>
        <ComboBox x:Name="AwayTeamBox"/>

        <TextBlock Text="Match Date and Time"/>

        <TextBox x:Name="DateBox"
                 PlaceholderText="Example: 30 Aug 2026 15:00"/>

        <TextBlock Text="Assigned Referee"/>

        <ComboBox x:Name="RefereeBox"
                  SelectedIndex="0">
            <ComboBoxItem Content="Demo Referee"/>
        </ComboBox>

        <Button Content="Schedule Match"
                Click="ScheduleMatch_Click"
                Height="50"/>

        <TextBlock x:Name="MessageText"
                   FontSize="16"
                   TextWrapping="Wrap"/>

        <Button Content="Back to Admin Dashboard"
                Click="Back_Click"
                Height="45"/>

    </StackPanel>

</Window>