<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KickHub.Desktop.Views.MatchManagementWindow"
        Width="900"
        Height="650"
        Title="KickHub - Match Management">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="MATCH MANAGEMENT"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock x:Name="MatchText"
                   Text="Selected Match"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock x:Name="ScoreText"
                   Text="0 - 0"
                   FontSize="40"
                   HorizontalAlignment="Center"/>

        <TextBlock x:Name="StatusText"
                   Text="Scheduled"
                   FontSize="18"
                   HorizontalAlignment="Center"/>

        <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="10">

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Content="Home Goal"
                    Click="HomeGoal_Click"
                    Height="45"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Content="Away Goal"
                    Click="AwayGoal_Click"
                    Height="45"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Content="Yellow Card"
                    Click="YellowCard_Click"
                    Height="45"/>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="Red Card"
                    Click="RedCard_Click"
                    Height="45"/>

            <Button Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="Finish Match"
                    Click="FinishMatch_Click"
                    Height="50"/>

        </Grid>

        <TextBlock x:Name="EventText"
                   Text="No events recorded."
                   FontSize="16"
                   TextWrapping="Wrap"/>

        <Button Content="Back to Assigned Matches"
                Click="Back_Click"
                Height="45"/>

    </StackPanel>

</Window>