<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KickHub.Desktop.Views.PlayerDashboard"
        Width="900"
        Height="600"
        Title="KickHub - Player Dashboard">

    <StackPanel Margin="30" Spacing="20">

        <TextBlock Text="PLAYER DASHBOARD"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock Text="Welcome to KickHub"
                   FontSize="20"/>

        <Button Content="View My Team"
                Height="50"/>

        <Button Content="View Matches"
                Height="50"/>

        <Button Content="View Player Statistics"
                Height="50"/>

        <Button Content="View Match Results"
                Height="50"/>

    </StackPanel>

</Window>