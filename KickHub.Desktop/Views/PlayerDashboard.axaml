<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KickHub.Desktop.Views.PlayerDashboard"
        Width="900"
        Height="700"
        Title="KickHub - Player Dashboard">

    <ScrollViewer>
        <StackPanel Margin="30" Spacing="15">

            <TextBlock Text="PLAYER DASHBOARD"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock x:Name="WelcomeText"
                       Text="Welcome!"
                       FontSize="20"/>

            <!-- PLAYER PROFILE -->
            <Border Padding="15">
                <StackPanel Spacing="8">

                    <TextBlock Text="PLAYER PROFILE"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="NameText"
                               Text="Name:"/>

                    <TextBlock x:Name="TeamText"
                               Text="Team:"/>

                    <TextBlock x:Name="ShirtText"
                               Text="Shirt Number:"/>

                </StackPanel>
            </Border>

            <!-- STATISTICS -->
            <Border Padding="15">
                <StackPanel Spacing="8">

                    <TextBlock Text="MY STATISTICS"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="GoalsText"
                               Text="Goals: 0"/>

                    <TextBlock x:Name="YellowCardsText"
                               Text="Yellow Cards: 0"/>

                    <TextBlock x:Name="RedCardsText"
                               Text="Red Cards: 0"/>

                </StackPanel>
            </Border>

            <!-- MATCHES -->
            <Border Padding="15">
                <StackPanel Spacing="8">

                    <TextBlock Text="MY TEAM'S MATCHES"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <ListBox x:Name="MatchList"
                             Height="200"/>

                </StackPanel>
            </Border>

            <TextBlock x:Name="MessageText"
                       FontSize="16"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>

</Window>