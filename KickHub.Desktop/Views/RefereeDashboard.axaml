<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KickHub.Desktop.Views.RefereeDashboard"
        Width="900"
        Height="650"
        Title="KickHub - Referee Dashboard">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="REFEREE DASHBOARD"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock Text="My Assigned Matches"
                   FontSize="22"
                   FontWeight="Bold"/>

        <TextBlock Text="Select an assigned match to manage it."
                   FontSize="16"/>

        <ListBox x:Name="MatchList"
                 Height="300"/>

        <Button Content="Manage Selected Match"
                Click="ManageMatch_Click"
                Height="50"/>

        <TextBlock x:Name="MessageText"
                   Text=""
                   FontSize="16"
                   TextWrapping="Wrap"/>

    </StackPanel>

</Window>